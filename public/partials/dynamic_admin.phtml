	<script>
	(function () {
		function getVisualStatusText(value, timeValue) {
			if (value === "Left Early") {
				return timeValue ? "Left/Leaves Early at " + timeValue : "Left/Leaves Early";
			}
			return value;
		}

		document.querySelectorAll(".asc-session-card").forEach(function(card) {
			const statusButtons = card.querySelectorAll('[data-role="status"] .asc-toggle-btn');
			const capacityButtons = card.querySelectorAll('[data-role="capacity"] .asc-toggle-btn');
			const statusBadge = card.querySelector(".asc-status-badge");
			const capacityBadge = card.querySelector(".asc-capacity-badge");
			const statusInput = card.querySelector(".asc-status-input");
			const capacityInput = card.querySelector(".asc-capacity-input");
			const leftEarlyWrap = card.querySelector(".asc-left-early-wrap");
			const leftEarlyTime = card.querySelector(".asc-left-early-time");
			const resetButton = card.querySelector(".asc-reset-btn");
			const capacityNote = card.querySelector(".asc-capacity-note");

			const initialStatus = statusInput ? statusInput.value : "Not Checked In";
			const initialCapacity = capacityInput ? capacityInput.value : "Normal";
			const initialNote = capacityNote ? capacityNote.value : "";
			const initialLeftEarlyTime = leftEarlyTime ? leftEarlyTime.value : "";

			function setActive(buttons, clickedButton) {
				buttons.forEach(function(btn) {
					btn.classList.remove("is-active");
				});
				if (clickedButton) {
					clickedButton.classList.add("is-active");
				}
			}

			function findButtonByValue(buttons, value) {
				return Array.from(buttons).find(function(btn) {
					return btn.dataset.value === value;
				});
			}

			function updateStatusUI(value) {
				statusInput.value = value;

				statusBadge.classList.remove(
					"asc-pill-green",
					"asc-pill-red",
					"asc-pill-gray",
					"asc-pill-gold"
				);

				if (value === "Checked In") {
					statusBadge.classList.add("asc-pill-green");
				} else if (value === "Cancelled") {
					statusBadge.classList.add("asc-pill-red");
				} else if (value === "Left Early") {
					statusBadge.classList.add("asc-pill-gold");
				} else {
					statusBadge.classList.add("asc-pill-gray");
				}

				if (value === "Left Early") {
					leftEarlyWrap.hidden = false;
					statusBadge.textContent = getVisualStatusText(value, leftEarlyTime?.value || "");
				} else {
					leftEarlyWrap.hidden = true;
					if (leftEarlyTime) {
						leftEarlyTime.value = "";
					}
					statusBadge.textContent = value;
				}
			}

			function updateCapacityUI(value) {
				capacityInput.value = value;

				capacityBadge.classList.remove(
					"asc-capacity-normal",
					"asc-capacity-full"
				);

				if (value === "Full") {
					capacityBadge.classList.add("asc-capacity-full");
				} else {
					capacityBadge.classList.add("asc-capacity-normal");
				}

				capacityBadge.textContent = value;
			}

			statusButtons.forEach(function(button) {
				button.addEventListener("click", function() {
					setActive(statusButtons, button);
					updateStatusUI(button.dataset.value);
				});
			});

			capacityButtons.forEach(function(button) {
				button.addEventListener("click", function() {
					setActive(capacityButtons, button);
					updateCapacityUI(button.dataset.value);
				});
			});

			if (leftEarlyTime) {
				leftEarlyTime.addEventListener("input", function() {
					if (statusInput && statusInput.value === "Left Early" && statusBadge) {
						statusBadge.textContent = getVisualStatusText("Left Early", leftEarlyTime.value);
					}
				});
			}

			resetButton.addEventListener("click", function() {
				const statusDefault = findButtonByValue(statusButtons, initialStatus);
				const capacityDefault = findButtonByValue(capacityButtons, initialCapacity);

				setActive(statusButtons, statusDefault);
				setActive(capacityButtons, capacityDefault);

				if (capacityNote) {
					capacityNote.value = initialNote;
				}
				if (leftEarlyTime) {
					leftEarlyTime.value = initialLeftEarlyTime;
				}

				updateStatusUI(initialStatus);
				updateCapacityUI(initialCapacity);

				if (statusBadge) {
					statusBadge.textContent = getVisualStatusText(initialStatus, initialLeftEarlyTime);
				}
			});
		});
	})();
	</script>
